rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Misma allowlist que AdminConfig y las Cloud Functions.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['elkinoswa@gmail.com'];
    }

    function premiumUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          'isPremium',
          'premiumActivatedAt',
          'premiumSource',
          'premiumPaymentId',
          'premiumCode',
          'pendingPromoDiscount',
          'acquiredViaPaid',
          'welcomeOfferExpiresAt',
          'paidAcquisitionAt',
          'rescueEmailSent',
          'reminderOfferSentAt',
          'reminderOfferLastError',
          'organicWelcomeSent',
          'organicWelcomeSentAt',
          'upsellEmailSent',
          'upsellEmailSentAt',
        ]);
    }

    function premiumNotSetOnCreate() {
      return (!('isPremium' in request.resource.data)
        || request.resource.data.isPremium == false)
        && (
          !('acquiredViaPaid' in request.resource.data)
          || request.resource.data.acquiredViaPaid == false
        )
        && !('welcomeOfferExpiresAt' in request.resource.data)
        && !('rescueEmailSent' in request.resource.data)
        && !('reminderOfferSentAt' in request.resource.data)
        && !('organicWelcomeSent' in request.resource.data)
        && !('upsellEmailSent' in request.resource.data);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && premiumNotSetOnCreate();
      allow update: if isOwner(userId) && (
        !exists(/databases/$(database)/documents/users/$(userId))
        || premiumUnchanged()
      );
      allow delete: if false;

      // Dispositivos Premium: solo lectura del dueño; escritura vía Admin SDK.
      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Banco del cerebro: lectura para usuarios autenticados; escritura solo Admin SDK.
    match /questions/{questionId} {
      allow read: if request.auth != null
        && resource.data.published == true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Códigos promo: solo Admin SDK (Cloud Functions / consola).
    match /promoCodes/{codeId} {
      allow read, write: if false;
      match /redemptions/{uid} {
        allow read, write: if false;
      }
    }

    // Opiniones: lectura pública solo si approved; escritura vía Cloud Functions.
    match /testimonials/{id} {
      allow read: if resource.data.approved == true;
      allow write: if false;
    }

    // Noticias: lectura pública de publicadas; escritura solo Admin SDK.
    match /news/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // Casos de reels: lectura pública para que la fuente de OBS (sin sesión)
    // pueda pintar un caso creado a mano. Escritura solo el admin.
    match /reelClips/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Usados y ocultos del estudio de reels. Escritura solo admin.
    match /reelStudio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Estado del directo YouTube. OBS lee sin sesión; solo el admin escribe.
    match /liveStudio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
